# Application role. Subject to row-level security; used by every agent run,
# the execution engine and the capability broker.
PALUGADA_APP_URL=postgres://palugada_app:dev_app@127.0.0.1:5432/palugada

# Control-plane role. Holds BYPASSRLS and must never be reachable from agent
# code paths. Used only for platform operations such as creating a company.
PALUGADA_ADMIN_URL=postgres://palugada_admin:dev_admin@127.0.0.1:5432/palugada

# Migration role. Owns the schema objects.
PALUGADA_OWNER_URL=postgres://palugada_owner:dev_owner@127.0.0.1:5432/palugada
