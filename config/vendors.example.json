{
  "capabilities": [
    {
      "name": "email.send",
      "adapter": "resend",
      "tier": 2,
      "method": "POST",
      "url": "https://api.resend.com/emails",
      "headers": {
        "authorization": "Bearer {credential}",
        "idempotency-key": "{idempotencyKey}"
      },
      "body": {
        "from": "{input.from}",
        "to": "{input.to}",
        "subject": "{input.subject}",
        "text": "{input.body}"
      },
      "input": {
        "type": "object",
        "required": ["from", "to", "subject", "body"],
        "properties": {
          "from": { "type": "string", "description": "The sender: an address on a domain verified with Resend." },
          "to": {
            "anyOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" }, "minItems": 1, "maxItems": 50 }],
            "description": "One address, or up to fifty for a batch."
          },
          "subject": { "type": "string", "minLength": 1 },
          "body": { "type": "string", "minLength": 1, "description": "The message, as plain text." }
        }
      },
      "result": "body.id",
      "credentialAlias": "email",
      "requiredScopes": ["email:send"],
      "verify": {
        "url": "https://api.resend.com/emails/{result}",
        "headers": { "authorization": "Bearer {credential}" },
        "matches": { "status": 200, "path": "body.id", "equalsPath": "result" }
      },
      "describe": {
        "recipientDomain": "to",
        "batchSize": "to"
      },
      "preflightUrl": "https://api.resend.com/domains",
      "estimatedCostCents": 1
    },
    {
      "name": "dns.read",
      "adapter": "cloudflare",
      "tier": 0,
      "method": "GET",
      "url": "https://api.cloudflare.com/client/v4/zones/{input.zoneId}/dns_records",
      "headers": { "authorization": "Bearer {credential}" },
      "result": "body.result",
      "credentialAlias": "dns",
      "requiredScopes": ["zone:read"],
      "preflightUrl": "https://api.cloudflare.com/client/v4/user/tokens/verify"
    },
    {
      "name": "dns.update",
      "adapter": "cloudflare",
      "tier": 1,
      "method": "PUT",
      "url": "https://api.cloudflare.com/client/v4/zones/{input.zoneId}/dns_records/{input.recordId}",
      "headers": {
        "authorization": "Bearer {credential}",
        "x-idempotency-key": "{idempotencyKey}"
      },
      "body": {
        "type": "{input.type}",
        "name": "{input.name}",
        "content": "{input.content}",
        "ttl": "{input.ttl}"
      },
      "result": "body.result",
      "credentialAlias": "dns",
      "requiredScopes": ["zone:read", "zone:edit"],
      "verify": {
        "url": "https://api.cloudflare.com/client/v4/zones/{input.zoneId}/dns_records/{input.recordId}",
        "headers": { "authorization": "Bearer {credential}" },
        "matches": { "status": 200, "path": "body.result.content", "equalsPath": "input.content" }
      },
      "preflightUrl": "https://api.cloudflare.com/client/v4/user/tokens/verify"
    },
    {
      "name": "invoice.issue",
      "adapter": "midtrans",
      "tier": 2,
      "method": "POST",
      "url": "https://api.sandbox.midtrans.com/v2/charge",
      "headers": { "authorization": "Basic {credentialBasic}" },
      "body": {
        "payment_type": "qris",
        "transaction_details": { "order_id": "{idempotencyKey}", "gross_amount": "{input.amount}" },
        "qris": { "acquirer": "gopay" }
      },
      "input": {
        "type": "object",
        "required": ["amount"],
        "properties": {
          "amount": { "type": "integer", "minimum": 1, "description": "The amount in whole rupiah, as Midtrans takes it." }
        }
      },
      "result": "body",
      "credentialAlias": "payments",
      "requiredScopes": ["payments:charge"],
      "verify": {
        "url": "https://api.sandbox.midtrans.com/v2/{idempotencyKey}/status",
        "headers": { "authorization": "Basic {credentialBasic}" },
        "matches": { "status": 200, "path": "body.transaction_status", "oneOf": ["pending", "settlement"] }
      },
      "describe": { "moneyUnits": "amount" }
    },
    {
      "name": "social.publish",
      "adapter": "mastodon",
      "tier": 2,
      "method": "POST",
      "url": "https://mastodon.social/api/v1/statuses",
      "headers": {
        "authorization": "Bearer {credential}",
        "idempotency-key": "{idempotencyKey}"
      },
      "body": { "status": "{input.text}", "visibility": "{input.visibility}", "language": "{input.language}" },
      "input": {
        "type": "object",
        "required": ["text"],
        "properties": {
          "text": { "type": "string", "minLength": 1, "maxLength": 500 },
          "visibility": { "enum": ["public", "unlisted", "private", "direct"] },
          "language": { "type": "string", "description": "ISO 639-1, such as id or en." }
        }
      },
      "result": "body.id",
      "credentialAlias": "social",
      "requiredScopes": ["write:statuses"],
      "verify": {
        "url": "https://mastodon.social/api/v1/statuses/{result}",
        "headers": { "authorization": "Bearer {credential}" },
        "matches": { "status": 200, "path": "body.id", "equalsPath": "result" }
      },
      "preflightUrl": "https://mastodon.social/api/v1/accounts/verify_credentials"
    },
    {
      "name": "metrics.read",
      "adapter": "plausible",
      "tier": 0,
      "method": "POST",
      "readOnly": true,
      "url": "https://plausible.io/api/v2/query",
      "headers": {
        "authorization": "Bearer {credential}",
        "idempotency-key": "{idempotencyKey}"
      },
      "body": { "site_id": "{input.siteId}", "metrics": "{input.metrics}", "date_range": "{input.dateRange}" },
      "input": {
        "type": "object",
        "required": ["siteId", "metrics", "dateRange"],
        "properties": {
          "siteId": { "type": "string", "description": "The site's domain, as Plausible knows it." },
          "metrics": {
            "type": "array",
            "minItems": 1,
            "items": { "enum": ["visitors", "visits", "pageviews", "views_per_visit", "bounce_rate", "visit_duration", "events"] }
          },
          "dateRange": {
            "anyOf": [
              { "enum": ["day", "7d", "30d", "month", "6mo", "12mo", "year", "all"] },
              { "type": "array", "items": { "type": "string" }, "minItems": 2, "maxItems": 2, "description": "A first and a last day, as YYYY-MM-DD." }
            ]
          }
        }
      },
      "result": "body.results",
      "credentialAlias": "analytics",
      "requiredScopes": ["stats:read"]
    },
    {
      "name": "calendar.read",
      "adapter": "google-calendar",
      "tier": 0,
      "method": "GET",
      "url": "https://www.googleapis.com/calendar/v3/calendars/primary/events?timeMin={input.from}&timeMax={input.to}&singleEvents=true&orderBy=startTime&maxResults=50",
      "headers": { "authorization": "Bearer {credential}" },
      "result": "body.items",
      "input": {
        "type": "object",
        "required": ["from", "to"],
        "properties": {
          "from": { "type": "string", "description": "The start of the window, as an RFC 3339 time with its offset." },
          "to": { "type": "string", "description": "The end of the window, the same way." }
        }
      },
      "credentialAlias": "google",
      "signIn": { "provider": "google", "scopes": ["https://www.googleapis.com/auth/calendar.events.readonly"] },
      "preflightUrl": "https://www.googleapis.com/calendar/v3/users/me/calendarList?maxResults=1"
    }
  ]
}
