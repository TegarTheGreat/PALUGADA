# systemd unit for one PALUGADA deployment.
#
# Restart on failure, but not on a configuration error: the process exits 78
# (EX_CONFIG) when a vendor file, price file, runtime spec or the owner's TOTP
# reference cannot be used, and restarting it would only reach the same
# refusal again, every ten seconds, for ever.
#
# KillMode=mixed sends SIGTERM to the main process first, which stops the
# console and lets the worker finish its step; the agent runtimes it started
# lead their own process groups and are ended by it. Anything still running
# when TimeoutStopSec expires gets SIGKILL.
#
# Not as root. The platform starts agent CLIs and runs code on a company's
# behalf, and a process that can do that as root can do anything to the host
# a runtime is talked into. DynamicUser gives the service its own unprivileged
# account, allocated by systemd and stable across restarts, with no login and
# nothing else on the machine owned by it. /opt/palugada must be readable by
# others (it is code, not configuration; the configuration is the env file
# and the credential below, which systemd hands over itself).
#
# The one writable place is the state directory. It is also HOME, because the
# agent CLIs keep their own configuration and login there (~/.claude,
# ~/.codex), and under ProtectHome a home in /home or /root would be neither
# readable nor writable. A company's files for files.list and the drafting
# capabilities belong under it too: set PALUGADA_FILES_ROOT in the env file to
# a directory below /var/lib/palugada.
[Unit]
Description=PALUGADA control plane
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/palugada
EnvironmentFile=/etc/palugada/palugada.env
ExecStart=/usr/bin/node src/main.ts
Restart=on-failure
RestartSec=10
RestartPreventExitStatus=78
KillMode=mixed
TimeoutStopSec=60
DynamicUser=true
StateDirectory=palugada
Environment=HOME=/var/lib/palugada
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadOnlyPaths=/opt/palugada
# The owner's TOTP secret as a systemd credential rather than an environment
# variable: it is readable only by this service, at the path below, for as
# long as the service runs. Generate one with `npm run totp:new`.
LoadCredential=owner-totp:/etc/palugada/owner-totp
Environment=PALUGADA_SECRET_DIRS=/run/credentials/palugada.service
Environment=PALUGADA_OWNER_TOTP_REF=file:///run/credentials/palugada.service/owner-totp

[Install]
WantedBy=multi-user.target
