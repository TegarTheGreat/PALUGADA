{
  "name": "palugada",
  "version": "0.1.0",
  "private": true,
  "description": "Orchestration platform for autonomous AI-operated companies with a single human owner",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "setup": "node scripts/setup.ts",
    "db:setup": "bash scripts/setup-database.sh",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run console:build && npm test",
    "smoke": "node --env-file-if-exists=.env scripts/smoke.ts",
    "totp:new": "node scripts/new-totp.ts",
    "company:import": "node --env-file-if-exists=.env scripts/import-company.ts",
    "start": "node --env-file-if-exists=.env src/main.ts",
    "console:install": "npm --prefix console ci",
    "console:build": "npm --prefix console run build"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "cron-parser": "^4.9.0",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "typescript": "^5.6.0"
  }
}
