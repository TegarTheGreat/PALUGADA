{
  "name": "palugada",
  "version": "0.1.0",
  "private": true,
  "description": "Orchestration platform for autonomous AI-operated companies with a single human owner",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "setup": "node scripts/setup.ts",
    "db:setup": "bash scripts/setup-database.sh",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
    "pretest": "node scripts/require-console.ts",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "pretest:coverage": "node scripts/require-console.ts && node -e \"require('node:fs').mkdirSync('coverage', { recursive: true })\"",
    "test:coverage": "node --test --test-concurrency=1 --experimental-test-coverage --test-coverage-include=\"src/**\" --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info \"test/**/*.test.ts\" && node scripts/coverage-report.ts coverage/lcov.info",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run console:build && npm test",
    "smoke": "node --env-file-if-exists=.env scripts/smoke.ts",
    "totp:new": "node scripts/new-totp.ts",
    "company:import": "node --env-file-if-exists=.env scripts/import-company.ts",
    "container:check": "node scripts/container-check.ts",
    "compute:check": "node scripts/compute-check.ts",
    "start": "node --env-file-if-exists=.env src/main.ts",
    "console:install": "npm --prefix console ci",
    "console:build": "npm --prefix console run build"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "cron-parser": "^5.10.1",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "typescript": "^7.0.2"
  }
}
